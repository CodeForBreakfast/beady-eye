# An untracked `.envrc.local` can select another dev shell with
# `devshell=maintainer`, and an untracked `.env.local` supplies its environment.
# With neither file this is a no-op and the default shell stands.
#
# Both files are gitignored, so they exist only in the main checkout. A
# worktree resolves the main checkout's copy first, then its own. In the main
# checkout each pair names the same file, which is idempotent.
main_checkout="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")"

dotenv_if_exists "$main_checkout/.env.local"
dotenv_if_exists .env.local

source_env_if_exists "$main_checkout/.envrc.local"
source_env_if_exists .envrc.local

# One `use flake`, here, on the shell those files chose. nix-direnv names its
# cache after the flake expression but deletes every profile in `.direnv`
# before writing its own, so a second call — here or in a sourced
# `.envrc.local` — evicts the first and both rebuild on every load.
use flake ".#${devshell:-default}"
