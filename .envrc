# .env.local is gitignored, so it exists only in the main checkout — a worktree
# gets the tracked .beads/config.yaml with no BEADS_DOLT_PASSWORD to
# authenticate it. Load the main checkout's copy first, then let a
# worktree-local file override it. In the main checkout both lines name the
# same file, which is idempotent.
dotenv_if_exists "$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")/.env.local"
dotenv_if_exists .env.local
