#!/bin/sh
# A `bd` a test can answer for and hold up: it says what a file tells it to
# say, and stops answering while a flag file is there — a tracker that hangs
# rather than fails.
#
# `bdi` reaches bd by a PATH lookup (src/collect/run.rs), so this directory
# first on PATH is enough to give a machine with no tracker a project to
# read, and to inject any delay, without touching `bdi` at all. That is what
# makes a hung tracker reachable — it is otherwise a state only a broken
# network produces.
#
#   BDI_SHIM_BD_ANSWERS      directory holding one file per call, named by the
#                            call as bdi asks it past whatever flags open it:
#                            `list --all --limit 0 --json`, `blocked --json`,
#                            `where --json`. A call with a file there is
#                            answered with it; any other is refused.
#   BDI_SHIM_BD_UNANSWERED   file this appends each call it had no answer for
#                            to, so a reader can tell a capture that was not
#                            served from one that was served wrongly.
#   BDI_SHIM_BD_CALLED       file this appends every call to, answered or not,
#                            so a reader can say bd was never asked about a
#                            project at all. That is a different question from
#                            the one above: a project bdi declined to open
#                            refuses nothing and answers nothing, so an empty
#                            unanswered file is what both a served capture and
#                            a tracker nobody touched leave behind.
#   BDI_SHIM_BD_HANGS_WHILE  path to the flag. Touch it and every bd call from
#                            then on waits until it goes away; write a call's
#                            opening words into it and only the calls starting
#                            that way wait.
#   BDI_SHIM_BD_HOLDING      path this writes while it is holding a call, so a
#                            reader can wait for the hang to have started
#                            rather than sleeping and hoping.
#
# Unset, it has no answer to give and refuses every call.
#
# Plain `sh`, and POSIX. A nix build sandbox holds `/bin/sh` and nothing else
# — no `/usr/bin/env`, no `bash` — and the suite runs in one. What decides
# whether that reaches you is who supplies the interpreter: nix does for a
# `writeShellScriptBin` or a `runCommand` builder, and those are safe. A
# script file the repository ships is executed as it stands, so its shebang
# is resolved against that filesystem. These are.
set -u

GIVING_UP=1200 # 60s at 50ms, so a leaked shim dies on its own.

# The subcommand and everything after it. Most calls from bdi open with flags
# naming the tracker (src/collect/bd.rs), so the subcommand is not $1 and a
# shim that tested $1 would key each of those by a flag, find nothing written
# down under that name, and refuse the lot. Scanned rather than counted, so
# one more leading flag does not put the shim back in that state.
asked() {
  while [ $# -gt 0 ]; do
    case $1 in
      -C) shift 2 ;;
      -*) shift ;;
      *) break ;;
    esac
  done
  printf '%s' "$*"
}
asked=$(asked "$@")

# Written down before anything below can hold, refuse or answer the call, so
# the record is of what bd was asked rather than of how asking it went.
if [ -n "${BDI_SHIM_BD_CALLED:-}" ]; then
  printf '%s\n' "$asked" >>"$BDI_SHIM_BD_CALLED"
fi

# Held after the call has been read rather than before, so the flag can name
# which call to hold: its first line is a prefix of the call, and an empty
# flag holds every one. A run with no config file asks `bd where` before it
# has a screen at all, so a hang that cannot tell one call from another can
# only hold that one — and the frames drawn while a *collection* is
# outstanding are then unreachable for a project discovery found.
if [ -n "${BDI_SHIM_BD_HANGS_WHILE:-}" ] && [ -e "$BDI_SHIM_BD_HANGS_WHILE" ]; then
  held=$(head -n 1 "$BDI_SHIM_BD_HANGS_WHILE" 2>/dev/null)
  case "$asked" in
    "$held"*)
      if [ -n "${BDI_SHIM_BD_HOLDING:-}" ]; then : >"$BDI_SHIM_BD_HOLDING"; fi
      waited=0
      while [ -e "$BDI_SHIM_BD_HANGS_WHILE" ] && [ "$waited" -lt "$GIVING_UP" ]; do
        sleep 0.05
        waited=$((waited + 1))
      done
      if [ -n "${BDI_SHIM_BD_HOLDING:-}" ]; then rm -f "$BDI_SHIM_BD_HOLDING"; fi
      ;;
  esac
fi

# `sql` is never answered from a file, whatever is there. bdi asks it for the
# tracker's working root and skips the whole read when the answer has not
# moved (src/app/tracker.rs), so a fixed answer would have the first read
# stand for every refresh after it: a test changing what the tracker holds
# would see nothing change and nothing go red. Refused, bdi has no root to
# compare the next read against and reads in full each time, which is the
# degradation it was built to take. An answer that moved with the files above
# would be safe; a constant is not.
case $asked in
  sql\ *)
    printf 'bd: the shim refuses "%s" rather than answer it or hand it on. The working root is the one answer that would stop bdi reading in full; the comment above this case says why.\n' "$*" >&2
    exit 127
    ;;
esac

if [ -n "${BDI_SHIM_BD_ANSWERS:-}" ] && [ -f "$BDI_SHIM_BD_ANSWERS/$asked" ]; then
  exec cat "$BDI_SHIM_BD_ANSWERS/$asked"
fi

if [ -n "${BDI_SHIM_BD_UNANSWERED:-}" ]; then
  printf '%s\n' "$asked" >>"$BDI_SHIM_BD_UNANSWERED"
fi

# Anything not answered above is refused rather than handed to the bd this
# shadows. One call carries no `-C`: `bd where --json`, which
# src/collect/discovery.rs asks to decide whether a directory is one beads
# tracks. bdi strips BEADS_DIR from every child, so a handed-on one resolves
# the tracker by walking up from the working directory — which under this
# repository is the maintainer's own, and it answers exit 0. Answering is
# what decides the directory is a project, so the hand-on did not read the
# wrong tracker quietly: it gave the run a success no test wrote down, on the
# machine somebody runs the suite by hand on and on no other. The machine
# that has no tracker is the machine `nix flake check` runs on, which is why
# passing calls through read as safe: the safety was present where nothing
# could go wrong and absent where everything could.
#
# What a person reads is the line BDI_SHIM_BD_UNANSWERED holds, not this one.
# bdi captures a child's stderr and drops it once the failure is classified
# (src/collect/run.rs), so this reaches whoever runs the shim by hand and
# nobody else. 127 is what the shims beside this one exit with, and a
# non-zero exit is what bdi already took from a bd that could not open the
# tracker: FailureKind::Unavailable either way.
printf 'bd: the shim was asked "%s", which nothing wrote an answer for and which it will not hand on to the bd it shadows. An answer for it is a file named "%s" under $BDI_SHIM_BD_ANSWERS.\n' "$*" "$asked" >&2
exit 127
