#!/bin/sh
# A `gh` a test can answer for: it says what a file tells it to say.
#
# `bdi gates` reaches gh by a PATH lookup, as it reaches bd, so this directory
# first on PATH puts a pull request in whatever state a test needs without a
# GitHub to ask.
#
#   BDI_SHIM_GH_ANSWERS  directory holding one file per call, named by the
#                        call as bdi asks it with each space made a `/`:
#                        `api/rate_limit`, so that a long call is a path of
#                        short names and not one name too long for the
#                        filesystem. A call with a file there is answered
#                        with it. A file named for the
#                        call with `.refused` after it refuses the call
#                        instead: it goes to stderr and the shim exits 1, as
#                        gh does.
#   BDI_SHIM_GH_CALLED   file this appends every call to, answered or not.
#
# Unset, it has no answer to give and refuses every call. Plain `sh`, for the
# reason the `bd` shim beside this one gives.
#
# It also refuses every call made with BDI_GATES_WEBHOOK_SECRET in its
# environment, which `bdi gates` is never to hand on.
set -u

asked="$*"
answer="${BDI_SHIM_GH_ANSWERS:-}/$(printf '%s' "$asked" | tr ' ' '/')"

if [ -n "${BDI_SHIM_GH_CALLED:-}" ]; then
  printf '%s\n' "$asked" >>"$BDI_SHIM_GH_CALLED"
fi

if [ -n "${BDI_GATES_WEBHOOK_SECRET+set}" ]; then
  printf 'gh: the shim was handed BDI_GATES_WEBHOOK_SECRET.\n' >&2
  exit 1
fi

if [ -n "${BDI_SHIM_GH_ANSWERS:-}" ] && [ -f "$answer.refused" ]; then
  cat "$answer.refused" >&2
  exit 1
fi

if [ -n "${BDI_SHIM_GH_ANSWERS:-}" ] && [ -f "$answer" ]; then
  exec cat "$answer"
fi

# Refused rather than handed on: the gh this shadows is signed in to
# whoever runs the suite.
printf 'gh: the shim was asked "%s", which nothing wrote an answer for and which it will not hand on to the gh it shadows.\n' "$asked" >&2
exit 127
