#!/bin/sh
# A `gh` a test can answer for: it says what a file tells it to say.
#
# `bdi gates` reaches gh by a PATH lookup, as it reaches bd, so this directory
# first on PATH puts a pull request in whatever state a test needs without a
# GitHub to ask.
#
#   BDI_SHIM_GH_ANSWERS  directory holding one answer per call, each beside a
#                        `<answer>.asked` holding the call as bdi asks it. The
#                        call is not in the name, because a long call makes a
#                        path longer than macOS allows. A call with an answer
#                        there is answered with it. An answer for the call
#                        with `.refused` after it refuses the call instead: it
#                        goes to stderr and the shim exits 1, as gh does.
#   BDI_SHIM_GH_CALLED   file this appends every call to, answered or not.
#
# Unset, it has no answer to give and refuses every call. Plain `sh`, for the
# reason the `bd` shim beside this one gives.
#
# It also refuses every call made with BDI_GATES_WEBHOOK_SECRET in its
# environment, which `bdi gates` is never to hand on.
set -u

asked="$*"

# The answer whose `.asked` holds exactly the call given, printed. Nothing
# when none does, and the shim exits 1 when more than one does, since which
# one a test meant cannot be known.
answer_for() {
  found=""
  for call in "${BDI_SHIM_GH_ANSWERS:-}"/*.asked; do
    if [ -f "$call" ] && [ "$(cat "$call")" = "$1" ]; then
      if [ -n "$found" ]; then
        printf 'gh: the shim holds more than one answer for "%s".\n' "$1" >&2
        exit 1
      fi
      found="${call%.asked}"
    fi
  done
  printf '%s' "$found"
}

if [ -n "${BDI_SHIM_GH_CALLED:-}" ]; then
  printf '%s\n' "$asked" >>"$BDI_SHIM_GH_CALLED"
fi

if [ -n "${BDI_GATES_WEBHOOK_SECRET+set}" ]; then
  printf 'gh: the shim was handed BDI_GATES_WEBHOOK_SECRET.\n' >&2
  exit 1
fi

if [ -n "${BDI_SHIM_GH_ANSWERS:-}" ]; then
  refusal=$(answer_for "$asked.refused") || exit 1
  if [ -n "$refusal" ]; then
    cat "$refusal" >&2
    exit 1
  fi
  answer=$(answer_for "$asked") || exit 1
  if [ -n "$answer" ]; then
    exec cat "$answer"
  fi
fi

# Refused rather than handed on: the gh this shadows is signed in to
# whoever runs the suite.
printf 'gh: the shim was asked "%s", which nothing wrote an answer for and which it will not hand on to the gh it shadows.\n' "$asked" >&2
exit 127
