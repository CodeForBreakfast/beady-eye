#!/bin/sh
# A `herdr` a test can answer for and hold up: it says what a file tells it to
# say, and stops answering `agent read` while a flag file is there.
#
# `bdi` reaches herdr by a PATH lookup (src/collect/run.rs), so this directory
# first on PATH is enough to give a machine with no herdr a session to read,
# and to hold a pane read outstanding — a state a working herdr never reaches,
# and the one that tells a stalled loop from a slow one.
#
# `bdi` names the session it is asking with `--session <name>` ahead of the
# subcommand, as herdr takes it, and the name is what picks the answer below.
#
#   BDI_SHIM_HERDR_SESSIONS     file holding what `session list --json` answers
#                               with. Unset, the list is refused.
#   BDI_SHIM_HERDR_AGENTS       directory holding what `agent list` answers
#                               with, one file per session, named
#                               `<session>.json`. Unset, the list is refused;
#                               set and holding no file for the session asked,
#                               the list fails as a session that will not
#                               answer does.
#   BDI_SHIM_HERDR_VISIBLE      file holding what `agent read` answers with.
#                               Unset, the read is refused.
#   BDI_SHIM_HERDR_HANGS_WHILE  path to the flag. While it is there, every
#                               `agent read` waits for it to go away.
#   BDI_SHIM_HERDR_HOLDING      path this writes while it is holding a read, so
#                               a reader can wait for the hold to have started
#                               rather than sleeping and hoping.
#   BDI_SHIM_HERDR_READS        file this appends a line to per `agent read` —
#                               `read <session> <pane>` — so a reader can count
#                               how often the band asked rather than time how
#                               late one answer was, and see which session's
#                               pane it asked for. An `agent focus` appends
#                               `focus <session> <pane>` to the same file and
#                               answers in place of the herdr this shadows, so
#                               a test can see the only write `bdi` performs
#                               without a real session to move.
#   BDI_SHIM_HERDR_READ_DELAY   seconds to wait before `agent read`, for
#                               measuring a herdr that is slow rather than
#                               stopped. A delay is not a hold: nothing can
#                               wait for one to have started.
#
# A call this has not been given an answer for is refused, whether the
# subcommand is one it knows or not. It never reaches the herdr it shadows:
# that one holds the reader's own panes.
#
# Plain `sh`, and POSIX, for the reason the bd shim beside this one gives.
set -u

GIVING_UP=1200 # 60s at 50ms, so a leaked shim dies on its own.

SESSION=""
if [ "${1:-}" = "--session" ]; then
  SESSION="${2:-}"
  shift 2
fi

if [ "${1:-}" = "session" ] && [ "${2:-}" = "list" ] && [ -n "${BDI_SHIM_HERDR_SESSIONS:-}" ]; then
  exec cat "$BDI_SHIM_HERDR_SESSIONS"
fi

if [ "${1:-}" = "agent" ] && [ "${2:-}" = "list" ] && [ -n "${BDI_SHIM_HERDR_AGENTS:-}" ]; then
  exec cat "$BDI_SHIM_HERDR_AGENTS/$SESSION.json"
fi

if [ "${1:-}" = "agent" ] && [ "${2:-}" = "focus" ] && [ -n "${BDI_SHIM_HERDR_READS:-}" ]; then
  printf 'focus %s %s\n' "$SESSION" "${3:-}" >>"$BDI_SHIM_HERDR_READS"
  exit 0
fi

if [ "${1:-}" = "agent" ] && [ "${2:-}" = "read" ]; then
  if [ -n "${BDI_SHIM_HERDR_READS:-}" ]; then
    printf 'read %s %s\n' "$SESSION" "${3:-}" >>"$BDI_SHIM_HERDR_READS"
  fi
  if [ -n "${BDI_SHIM_HERDR_READ_DELAY:-}" ]; then
    sleep "$BDI_SHIM_HERDR_READ_DELAY"
  fi
  if [ -n "${BDI_SHIM_HERDR_HANGS_WHILE:-}" ] && [ -e "$BDI_SHIM_HERDR_HANGS_WHILE" ]; then
    if [ -n "${BDI_SHIM_HERDR_HOLDING:-}" ]; then : >"$BDI_SHIM_HERDR_HOLDING"; fi
    waited=0
    while [ -e "$BDI_SHIM_HERDR_HANGS_WHILE" ] && [ "$waited" -lt "$GIVING_UP" ]; do
      sleep 0.05
      waited=$((waited + 1))
    done
    if [ -n "${BDI_SHIM_HERDR_HOLDING:-}" ]; then rm -f "$BDI_SHIM_HERDR_HOLDING"; fi
  fi
  if [ -n "${BDI_SHIM_HERDR_VISIBLE:-}" ]; then
    exec cat "$BDI_SHIM_HERDR_VISIBLE"
  fi
fi

# Anything not answered above is refused rather than handed to the herdr this
# shadows. That herdr answers for the session whoever is running the suite is
# sitting in, and `agent focus` moves a pane in it — so handing on is a write
# to a real workspace from a suite that goes green either way. The machine
# that has no herdr is the machine `nix flake check` runs on, which is why
# passing calls through read as safe: the safety was present where nothing
# could go wrong and absent where everything could. 127 and a line on stderr
# is what a machine with no herdr already got, so both now fail alike.
asked=$*
if [ -n "$SESSION" ]; then
  asked="--session $SESSION $*"
fi
printf 'herdr: the shim was asked "%s", which it has not learned to answer and will not hand on to the herdr it shadows. Teach it in tests/shims/herdr.\n' "$asked" >&2
exit 127
